{{#extend "widget"}}
{{#content "widget"}}
<frame pos="0 0" id="map">
  <quad pos="0 0" z-index="0" size="{{ ui.layout.height }} {{ ui.layout.height }}" bgcolor="{{ ui.colors.accentBackground }}" opacity="{{ ui.colors.accentOpacity }}"/>
  <quad pos="{{ ui.layout.height }} 0" z-index="0" size="{{ subtract ui.layout.width ui.layout.height }} {{ ui.layout.height }}" bgcolor="{{ ui.colors.rowBackground }}" opacity="{{ ui.colors.rowOpacity }}"/>
  <label pos="{{ divide ui.layout.height 2 }} {{ labelY ui.layout.height }}" z-index="0" size="{{ ui.layout.height }} {{ ui.layout.height }}" text="" halign="center" valign="center" textsize="{{ ui.textSizes.icon }}" textcolor="{{ ui.colors.accentText }}" textfont="GameFontRegular"/>
  <label pos="{{ add ui.layout.height 2 }} {{ subtract -0.25 (divide ui.layout.height 2) }}" z-index="0" size="{{ subtract ui.layout.width (add ui.layout.height 4) }} {{ divide ui.layout.height 2 }}" text="-" textcolor="{{ ui.colors.rowText }}" textsize="{{ ui.textSizes.name }}" textfont="{{ ui.fonts.name }}" valign="bottom"/>
  <label pos="{{ add ui.layout.height 1.75 }} {{ subtract -0.5 (divide ui.layout.height 2) }}" z-index="0" size="{{ subtract ui.layout.width (add ui.layout.height 4) }} {{ divide ui.layout.height 2 }}" text="-" textcolor="{{ ui.colors.authorText }}" textprefix="$i" textfont="{{ ui.fonts.author }}" valign="top" textsize="{{ ui.textSizes.author }}"/>
</frame>
{{/content}}


{{#content "globals"}}
#Struct Map {
  Text name;
  Text author;
}
{{/content}}

{{#content "script"}}
Void updateWidget(Map mapInfo) {
  declare mapFrame <=> (Page.MainFrame.GetFirstChild("map") as CMlFrame);

  (mapFrame.Controls[3] as CMlLabel).SetText(mapInfo.name);
  (mapFrame.Controls[4] as CMlLabel).SetText(mapInfo.author);
}
{{/content}}

{{#content "main"}}
declare Map MapInfo for This;
declare Integer LastMapInfoUpdate for This = -1;
declare Integer lastUpdate = -1;
{{/content}}


{{#content "loop"}}
if (LastMapInfoUpdate != lastUpdate) {
  lastUpdate = LastMapInfoUpdate;
  updateWidget(MapInfo);
}
{{/content}}
{{/extend}}