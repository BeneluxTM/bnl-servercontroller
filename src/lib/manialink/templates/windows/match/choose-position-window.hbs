{{#extend "window"}}
{{#content "window"}}
<frame pos="2 -2" id="choose-position-window" size="{{ subtract size.x 4 }} {{ subtract size.y 4 }}">
  {{#each data.positionsAvailable}}
    <frame pos="{{ multiply @index 12 }} 0" size="10 10">
      <quad pos="0 0" z-index="0" size="10 10" bgcolor="{{ @root.ui.colors.accentBackground }}" opacity="{{ @root.ui.colors.accentOpacity }}"/>
      <label pos="5 -4.5" z-index="0" size="10 10" text="{{ this }}" halign="center" valign="center" textsize="{{ @root.ui.textSizes.accent }}" textcolor="{{ @root.ui.colors.accentText }}" textfont="{{ @root.ui.fonts.accent }}"/>

      <quad class="trigger" pos="0 0" z-index="-2" size="10 10" bgcolor="000" opacity="0" scriptevents="1" action="{{ @root.data.choosePositionAction }}-{{ this }}" />
    </frame>
  {{/each}}
</frame>
{{/content}}
{{/extend}}